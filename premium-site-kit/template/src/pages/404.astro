---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page could not be found.">
  <section class="nf dark">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1 data-split="load">This address is <em>off-market.</em></h1>
      <p class="muted">The page you were looking for has moved or never existed.</p>
      <div class="nf__actions"><a href="/" class="btn btn--accent">Back home</a><a href="/properties" class="link">View properties</a></div>
    </div>
  </section>
</Base>
<style>
  .nf { min-height: 100svh; display: flex; align-items: center; padding-top: 6rem; }
  .nf h1 { margin: 1.5rem 0; max-width: 12ch; }
  .nf__actions { display: flex; gap: 2rem; align-items: center; margin-top: 2.5rem; }
</style>
