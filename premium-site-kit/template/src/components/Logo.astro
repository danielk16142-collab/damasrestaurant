---
import Monogram from './Monogram.astro';
interface Props { class?: string }
const { class: cls } = Astro.props;
---
<a href="/" class:list={['logo', cls]} aria-label="Vértice Real Estate, home">
  <Monogram class="logo__mark" />
  <span class="logo__word">
    <span class="logo__name">VÉRTICE</span>
    <span class="logo__sub">Real Estate</span>
  </span>
</a>
<style>
  .logo { display: inline-flex; align-items: center; gap: 0.85rem; color: var(--accent); }
  .logo :global(.logo__mark) { width: 2.6rem; height: auto; }
  .logo__word { display: grid; line-height: 1; }
  .logo__name {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.15rem;
    letter-spacing: 0.32em;
    margin-right: -0.32em;
  }
  .logo__sub {
    margin-top: 0.35rem;
    font-size: 0.55rem;
    font-weight: 500;
    letter-spacing: 0.42em;
    text-transform: uppercase;
  }
</style>
