---
// Numbered process: sticky heading on the left, steps scroll past on the right.
interface Props {
  eyebrow: string;
  steps: { title: string; text: string }[];
}
const { eyebrow, steps } = Astro.props;
---
<section class="process section">
  <div class="wrap process__grid">
    <div class="process__head">
      <p class="eyebrow" data-reveal>{eyebrow}</p>
      <h2 data-split><slot /></h2>
      <div class="process__meter" aria-hidden="true"><span></span></div>
    </div>
    <ol class="process__list" role="list">
      {steps.map((s, i) => (
        <li class="process__step" data-reveal>
          <span class="process__num num">0{i + 1}</span>
          <div>
            <h3>{s.title}</h3>
            <p class="muted">{s.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process__grid { display: grid; grid-template-columns: 1fr 1.2fr; gap: clamp(2rem, 7vw, 8rem); align-items: start; }
  .process__head { position: sticky; top: 8rem; display: grid; gap: 1.5rem; }
  .process__head h2 { max-width: 12ch; }
  .process__meter { width: 100%; max-width: 20rem; height: 1px; background: var(--line-light); margin-top: 1rem; }
  .process__meter span { display: block; height: 100%; background: var(--accent-deep); transform-origin: left; transform: scaleX(0); }
  .process__step { display: grid; grid-template-columns: 4.5rem 1fr; gap: 1rem; padding-block: clamp(1.75rem, 3.5vw, 3rem); border-top: 1px solid var(--line-light); }
  .process__step:last-child { border-bottom: 1px solid var(--line-light); }
  .process__num { font-size: var(--step-3); line-height: 1; color: var(--accent-deep); }
  .process__step h3 { font-size: var(--step-3); margin-bottom: 0.9rem; }
  .process__step p { max-width: 44ch; }
  @media (max-width: 860px) {
    .process__grid { grid-template-columns: 1fr; }
    .process__head { position: static; }
  }
</style>

<script>
  import { gsap } from '../scripts/motion';
  document.querySelectorAll<HTMLElement>('.process').forEach((section) => {
    const bar = section.querySelector('.process__meter span');
    const list = section.querySelector('.process__list');
    if (!bar || !list) return;
    gsap.to(bar, { scaleX: 1, ease: 'none', scrollTrigger: { trigger: list, start: 'top 60%', end: 'bottom 60%', scrub: true } });
  });
</script>
