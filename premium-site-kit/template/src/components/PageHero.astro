---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow: string;
  image?: ImageMetadata;
  imageAlt?: string;
  size?: 'tall' | 'short';
}
const { eyebrow, image, imageAlt = '', size = image ? 'tall' : 'short' } = Astro.props;
---
<section class:list={['phero dark on-image', `phero--${size}`]}>
  {image && (
    <div class="phero__media media" data-parallax="8">
      <Image src={image} alt={imageAlt} widths={[800, 1280, 1672]} sizes="100vw" loading="eager" fetchpriority="high" />
    </div>
    <div class="phero__shade"></div>
  )}
  <div class="phero__content wrap">
    <p class="eyebrow" data-reveal-load>{eyebrow}</p>
    <h1 class="phero__title" data-split="load" data-delay="0.1"><slot name="title" /></h1>
    <div class="phero__foot" data-reveal-load>
      <slot />
    </div>
  </div>
</section>

<style>
  .phero { position: relative; display: flex; align-items: flex-end; overflow: hidden; }
  .phero--tall { min-height: 88svh; }
  .phero--short { min-height: 62svh; }
  .phero__media { position: absolute; inset: 0; }
  .phero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(8 8 8 / 0.55) 0%, rgb(8 8 8 / 0) 25%),
      linear-gradient(0deg, rgb(8 8 8 / 0.85) 0%, rgb(8 8 8 / 0.3) 55%, rgb(8 8 8 / 0.1) 100%);
  }
  .phero__content { position: relative; padding-top: 9rem; padding-bottom: clamp(2.5rem, 5vw, 4.5rem); }
  .phero__title { margin-top: 1.5rem; max-width: 14ch; font-size: min(var(--step-5), 16svh); line-height: 0.95; letter-spacing: -0.03em; }
  .phero__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 1.5rem 3rem;
    margin-top: 2rem;
    padding-top: 1.75rem;
    border-top: 1px solid rgb(247 243 236 / 0.2);
    color: rgb(247 243 236 / 0.85);
  }
  .phero__foot:empty { display: none; }
  .phero__foot :global(p) { max-width: 44ch; font-size: var(--step-1); }
</style>

<script>
  import { gsap } from '../scripts/motion';
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    gsap.fromTo('.phero [data-reveal-load]', { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: 1.3, ease: 'expo.out', stagger: 0.12, delay: 0.5 });
  }
</script>
