---
import { site } from '../data/site';
import { routes, type Lang, type RouteKey } from '../i18n/ui';

interface Props {
  lang: Lang;
  page: RouteKey;
  title: string;
  description: string;
  image?: string;
  jsonLd?: Record<string, unknown>[];
}
const { lang, page, title, description, image = '/og/damas-og.jpg', jsonLd = [] } = Astro.props;
const abs = (p: string) => new URL(p, site.url).href;
const canonical = abs(routes[page][lang]);
const locale = lang === 'fr' ? 'fr_CA' : 'en_CA';

const dayMap: Record<string, string> = { Mo: 'Monday', Tu: 'Tuesday', We: 'Wednesday', Th: 'Thursday', Fr: 'Friday', Sa: 'Saturday', Su: 'Sunday' };
const restaurant = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  '@id': `${site.url}/#restaurant`,
  name: site.name,
  alternateName: site.legalName,
  url: abs(routes.home[lang]),
  image: [abs(image)],
  logo: abs('/favicon.svg'),
  telephone: site.phone,
  priceRange: site.priceRange,
  servesCuisine: lang === 'fr' ? ['Syrienne', 'Moyen-Orientale', 'Méditerranéenne'] : ['Syrian', 'Middle Eastern', 'Mediterranean'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.streetEn,
    addressLocality: 'Montréal',
    addressRegion: site.address.region,
    postalCode: site.address.postalCode,
    addressCountry: site.address.country,
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
  hasMap: site.mapsUrl,
  acceptsReservations: true,
  potentialAction: {
    '@type': 'ReserveAction',
    target: { '@type': 'EntryPoint', urlTemplate: site.reservationUrl, inLanguage: lang },
    result: { '@type': 'FoodEstablishmentReservation', name: lang === 'fr' ? 'Réserver une table' : 'Reserve a table' },
  },
  hasMenu: abs(routes.menus[lang]),
  foundingDate: String(site.since),
  founder: { '@type': 'Person', name: site.chef, jobTitle: lang === 'fr' ? 'Chef et copropriétaire' : 'Chef & co-owner' },
  award: site.awards.map((a) => `${a[lang]}${a.year ? ' ' + a.year : ''}`),
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: site.hours.dinner.days.map((d) => dayMap[d]), opens: site.hours.dinner.opens, closes: site.hours.dinner.closes },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: site.hours.brunch.days.map((d) => dayMap[d]), opens: site.hours.brunch.opens, closes: site.hours.brunch.closes },
  ],
  sameAs: [site.instagram, site.reservationUrl].filter(Boolean),
};
const graphs = [restaurant, ...jsonLd];
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{(['fr', 'en'] as const).map((l) => (
  <link rel="alternate" hreflang={l === 'fr' ? 'fr-CA' : 'en-CA'} href={abs(routes[page][l])} />
))}
<link rel="alternate" hreflang="x-default" href={abs(routes[page].fr)} />

<meta property="og:type" content="restaurant" />
<meta property="og:site_name" content="Damas" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={abs(image)} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={locale} />
<meta property="og:locale:alternate" content={lang === 'fr' ? 'en_CA' : 'fr_CA'} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="geo.region" content="CA-QC" />
<meta name="geo.placename" content="Montréal" />
<meta name="geo.position" content={`${site.geo.lat};${site.geo.lng}`} />

{graphs.map((g) => <script type="application/ld+json" set:html={JSON.stringify(g)} />)}
