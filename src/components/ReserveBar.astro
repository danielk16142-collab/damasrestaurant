---
// U5: the table is always one tap away. Desktop: a floating Réserver pill
// bottom right (Gem). Phones: a sticky bar with Réserver · Appeler · Itinéraire.
import { site } from '../lib/content';
import { url, useT, type Lang } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
---
<a href={url('reserve', lang)} class="rfloat" data-reserve-float>
  <span class="rfloat__dot" aria-hidden="true"></span>{t.reserveTable}
</a>
<nav class="rbar" aria-label={t.reserve}>
  <a href={url('reserve', lang)} class="rbar__main">{t.reserve}</a>
  <a href={`tel:${site.phoneIntl}`}>{t.call}</a>
  <a href={site.mapsUrl} target="_blank" rel="noopener">{t.directions}</a>
</nav>

<style>
  .rfloat {
    position: fixed;
    right: var(--gutter);
    bottom: var(--gutter);
    z-index: 80;
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    min-height: 3rem;
    padding: 0 1.3rem;
    border-radius: var(--radius);
    background: var(--accent);
    color: var(--ink);
    font-size: var(--step--2);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    box-shadow: 0 10px 40px rgb(18 10 13 / 0.45);
    transform: translateY(calc(100% + var(--gutter) + 1.5rem));
    transition: transform 0.8s var(--ease-out), background 0.4s;
  }
  .rfloat:hover { background: var(--paper); }
  .rfloat__dot { width: 7px; height: 7px; border-radius: 50%; background: var(--ink); animation: pulse 2.4s ease-in-out infinite; }
  @keyframes pulse { 50% { opacity: 0.25; } }
  /* Appears once the hero is behind you; hidden where the page already shows the widget */
  :global(html[data-scrolled]) .rfloat { transform: none; }
  :global(html[data-page='reserve']) .rfloat, :global(html.menu-open) .rfloat { transform: translateY(calc(100% + var(--gutter) + 1.5rem)); }

  .rbar { display: none; }
  @media (max-width: 760px) {
    .rfloat { display: none; }
    .rbar {
      position: fixed;
      inset: auto 0 0;
      z-index: 85;
      display: grid;
      grid-template-columns: 1.4fr 1fr 1fr;
      background: rgb(18 10 13 / 0.94);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-top: 1px solid var(--line-dark);
      padding-bottom: env(safe-area-inset-bottom);
    }
    .rbar a {
      display: grid;
      place-items: center;
      min-height: 3.4rem;
      font-size: var(--step--2);
      font-weight: 600;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--paper);
    }
    .rbar a + a { border-left: 1px solid var(--line-dark); }
    .rbar__main { background: var(--accent); color: var(--ink) !important; }
    :global(body) { padding-bottom: calc(3.4rem + env(safe-area-inset-bottom)); }
  }
  @media (prefers-reduced-motion: reduce) { .rfloat__dot { animation: none; } }
</style>
