---
// L1 + L6 (signature moment, part 1): the red tulip-and-carnation emblem blooms,
// the wordmark settles into it, then the curtain lifts in the shape of an arch.
// Under 2 s, once per browser session, skippable; skipped under reduced motion.
import Emblem from './Emblem.astro';
import Wordmark from './Wordmark.astro';
import { useT, type Lang } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<div class="intro" aria-hidden="true">
  <div class="intro__lockup">
    <Emblem class="intro__emblem" color="red" loading="eager" />
    <span class="intro__word"><Wordmark /></span>
  </div>
  <button class="intro__skip" type="button" tabindex="-1">{useT(lang).skipIntro}</button>
</div>

<script is:inline>
  (function () {
    var root = document.documentElement;
    var intro = document.querySelector('.intro');
    var seen = false;
    try { seen = sessionStorage.getItem('damas-intro') === '1'; sessionStorage.setItem('damas-intro', '1'); } catch (e) {}
    var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (seen || reduce) { intro.remove(); return; }
    if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
    window.scrollTo(0, 0);
    root.dataset.intro = '1.35';
    root.classList.add('intro-playing');
    var done = function () { root.classList.remove('intro-playing'); if (intro.isConnected) intro.remove(); };
    setTimeout(done, 2000);
    intro.addEventListener('click', function () { intro.classList.add('intro--skip'); setTimeout(done, 450); });
  })();
</script>

<style>
  .intro {
    position: fixed;
    inset: 0;
    z-index: 500;
    display: grid;
    place-items: center;
    background: var(--ink);
    animation: intro-lift 0.75s var(--ease-in-out) 1.25s forwards;
  }
  .intro--skip { animation: intro-lift 0.45s var(--ease-in-out) forwards; }
  .intro__lockup { position: relative; width: min(640px, 84vw); aspect-ratio: 895 / 658; }
  .intro :global(.intro__emblem) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    clip-path: circle(0% at 50% 50%);
    transform: rotate(-6deg) scale(0.9);
    animation: intro-bloom 1.05s var(--ease-out) 0.05s forwards;
  }
  /* The wordmark sits exactly where it lives inside the brand artwork */
  .intro__word {
    position: absolute;
    left: 17.3%;
    top: 36.2%;
    width: 60.4%;
    color: var(--paper);
    opacity: 0;
    filter: blur(8px);
    animation: intro-word 0.7s var(--ease-out) 0.45s forwards;
  }
  .intro__word :global(svg) { width: 100%; height: auto; }
  .intro__skip {
    position: absolute;
    right: var(--gutter);
    bottom: var(--gutter);
    font-size: var(--step--2);
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--mist);
  }
  @keyframes intro-bloom { to { clip-path: circle(75% at 50% 50%); transform: none; } }
  @keyframes intro-word { to { opacity: 1; filter: blur(0); } }
  @keyframes intro-lift { to { clip-path: inset(0 0 100% 0 round 0 0 50% 50%); } }
  :global(html.intro-playing) { overflow: hidden; }
</style>
