---
import { t, fmtTime, type Lang } from '../i18n/ui';
import { site } from '../data/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t[lang];
const { dinner, brunch } = site.hours;
---
<dl class="hours">
  <div>
    <dt>{s.dinner}</dt>
    <dd>{s.dinnerDays}, {s.from} {fmtTime(dinner.opens, lang)}</dd>
  </div>
  <div>
    <dt>{s.brunch}</dt>
    <dd>{s.brunchDays}, {fmtTime(brunch.opens, lang)} – {fmtTime(brunch.closes, lang)}</dd>
  </div>
</dl>
<style>
  .hours { display: grid; gap: 0.5rem; }
  .hours dt { font-family: var(--f-display); font-size: 1.15rem; font-weight: 400; }
  .hours dd { margin: 0; color: var(--cream-dim); }
</style>
