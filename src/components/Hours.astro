---
import { site } from '../lib/content';
import { fmtTime, useT, type Lang } from '../lib/i18n';
interface Props { lang: Lang; class?: string }
const { lang, class: cls } = Astro.props;
const t = useT(lang);
const { dinner, brunch } = site.hours;
---
<div class:list={['hours', cls]}>
<dl class="hours__list">
  <div>
    <dt>{t.dinner}</dt>
    <dd>{t.everyDay}<br /><span class="num">{fmtTime(dinner.opens, lang)} – {fmtTime(dinner.closes, lang)}</span></dd>
  </div>
  <div>
    <dt>{t.brunch}</dt>
    <dd>{t.weekend}<br /><span class="num">{fmtTime(brunch.opens, lang)} – {fmtTime(brunch.closes, lang)}</span></dd>
  </div>
</dl>
  <p class="hours__note">{t.closedNewYear}</p>
</div>
<style>
  .hours, .hours__list { display: grid; gap: 0.9rem; }
  .hours__list { margin: 0; }
  .hours dt { font-size: var(--step--2); font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; }
  .hours dd { margin: 0.2rem 0 0; }
  .hours__note { color: var(--mist); font-size: var(--step-0); }
  :global(.paper) .hours__note { color: var(--stone); }
</style>
