---
// Embers rising from the charcoal (Nuit III). A small canvas that only runs
// while its section is on screen, and not at all under reduced motion.
---
<canvas class="embers" data-embers aria-hidden="true"></canvas>
<style>
  .embers { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 1; pointer-events: none; mix-blend-mode: screen; }
</style>
<script>
  import { ScrollTrigger } from '../scripts/motion';
  document.querySelectorAll<HTMLCanvasElement>('[data-embers]').forEach((canvas) => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const dpr = Math.min(devicePixelRatio || 1, 2);
    type P = { x: number; y: number; r: number; vy: number; vx: number; life: number; max: number; hue: number };
    let parts: P[] = [];
    let w = 0, h = 0, raf = 0, running = false;
    const resize = () => {
      w = canvas.clientWidth; h = canvas.clientHeight;
      canvas.width = w * dpr; canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    const spawn = (): P => ({ x: Math.random() * w, y: h + 10, r: Math.random() * 1.7 + 0.4, vy: -(Math.random() * 0.8 + 0.35), vx: (Math.random() - 0.5) * 0.3, life: 0, max: Math.random() * 380 + 220, hue: 20 + Math.random() * 20 });
    const tick = () => {
      ctx.clearRect(0, 0, w, h);
      if (parts.length < Math.min(130, w / 9)) parts.push(spawn());
      parts = parts.filter((p) => p.life < p.max && p.y > -20);
      for (const p of parts) {
        p.life++; p.y += p.vy; p.x += p.vx + Math.sin((p.life + p.hue * 10) / 40) * 0.25;
        const a = Math.sin((p.life / p.max) * Math.PI);
        ctx.beginPath();
        ctx.fillStyle = `hsla(${p.hue}, 95%, ${55 + a * 15}%, ${a * 0.9})`;
        ctx.shadowColor = `hsla(${p.hue}, 100%, 60%, ${a})`;
        ctx.shadowBlur = 8;
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fill();
      }
      raf = requestAnimationFrame(tick);
    };
    resize();
    addEventListener('resize', resize);
    ScrollTrigger.create({
      trigger: canvas.parentElement, start: 'top bottom', end: 'bottom top', refreshPriority: -1,
      onToggle: (s) => {
        if (s.isActive && !running) { running = true; tick(); }
        else if (!s.isActive && running) { running = false; cancelAnimationFrame(raf); }
      },
    });
  });
</script>
