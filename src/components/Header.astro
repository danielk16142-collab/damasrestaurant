---
import { Image } from 'astro:assets';
import { routes, t, type Lang, type RouteKey } from '../i18n/ui';
import { site } from '../data/site';
import navHome from '../assets/photos/salon-lanternes.jpg';
import navMenus from '../assets/photos/mezzes-cuivre.jpg';
import navEvents from '../assets/photos/evenements-prives.avif';
import navContact from '../assets/photos/moucharabieh.jpg';
import navStory from '../assets/photos/salle-soir.jpg';

interface Props { lang: Lang; page: RouteKey }
const { lang, page } = Astro.props;
const s = t[lang];
const other: Lang = lang === 'fr' ? 'en' : 'fr';
const items: { key: RouteKey; img: ImageMetadata; ar: string }[] = [
  { key: 'home', img: navHome, ar: 'البيت' },
  { key: 'story', img: navStory, ar: 'الحكاية' },
  { key: 'menus', img: navMenus, ar: 'المائدة' },
  { key: 'events', img: navEvents, ar: 'السهرة' },
  { key: 'contact', img: navContact, ar: 'الطريق' },
];
---
<header class="hdr" data-header>
  <a class="hdr__logo" href={routes.home[lang]} aria-label={lang === 'fr' ? 'Damas — accueil' : 'Damas — home'}>
    <img src="/brand/wordmark-cream.svg" alt="Damas" width="108" height="34" />
  </a>
  <div class="hdr__right">
    <a class="hdr__lang" href={routes[page][other]} hreflang={other} lang={other} aria-label={s.otherLangLabel}>{s.otherLang}</a>
    <a class="btn btn--solid hdr__reserve" href={site.reservationUrl} target="_blank" rel="noopener" data-cursor>
      <span>{s.reserve}</span>
    </a>
    <button class="hdr__toggle" aria-expanded="false" aria-controls="nav-overlay" data-nav-toggle data-cursor>
      <span class="hdr__toggle-label" data-open-label={s.menu} data-close-label={s.close}>{s.menu}</span>
      <span class="hdr__burger" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>
</header>

<div class="nav" id="nav-overlay" data-nav hidden>
  <div class="nav__bg" aria-hidden="true"></div>
  <div class="nav__inner wrap">
    <nav aria-label={lang === 'fr' ? 'Navigation principale' : 'Main navigation'} class="nav__list">
      <ol>
        {items.map((it, i) => (
          <li>
            <a href={routes[it.key][lang]} data-nav-link data-idx={i} aria-current={it.key === page ? 'page' : undefined} data-cursor>
              <span class="nav__num">{String(i + 1).padStart(2, '0')}</span>
              <span class="nav__label display">{s.nav[it.key]}</span>
              <span class="nav__ar arabic" aria-hidden="true">{it.ar}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
    <div class="nav__visual arch" aria-hidden="true">
      {items.map((it, i) => (
        <Image src={it.img} alt="" widths={[480, 800]} sizes="(max-width: 900px) 0px, 32vw" class:list={['nav__img', { 'is-on': i === 0 }]} data-nav-img={i} loading="lazy" />
      ))}
    </div>
    <div class="nav__foot">
      <a href={site.mapsUrl} target="_blank" rel="noopener" class="link-u">{site.address[lang === 'fr' ? 'street' : 'streetEn']}, Outremont</a>
      <a href={`tel:${site.phone}`} class="link-u">{site.phoneDisplay}</a>
      <a href={site.reservationUrl} target="_blank" rel="noopener" class="btn btn--solid">{s.reserveLong}</a>
    </div>
  </div>
</div>

<style>
  .hdr {
    position: fixed; inset: 0 0 auto; z-index: 100;
    height: var(--header-h);
    display: flex; align-items: center; justify-content: space-between;
    padding-inline: var(--gutter);
    transition: transform 0.7s var(--ease), background 0.5s;
  }
  .hdr::before {
    content: ''; position: absolute; inset: 0 0 -40px; z-index: -1; pointer-events: none;
    background: linear-gradient(to bottom, rgb(18 10 13 / 0.85), transparent);
    opacity: 0; transition: opacity 0.6s;
  }
  :global(.is-scrolled) .hdr::before { opacity: 1; }
  :global(.is-hidden-hdr) .hdr { transform: translateY(-110%); }
  .hdr__logo img { width: clamp(84px, 8vw, 116px); height: auto; }
  .hdr__right { display: flex; align-items: center; gap: clamp(0.75rem, 2vw, 1.75rem); }
  .hdr__lang { font-size: 0.75rem; letter-spacing: 0.2em; font-weight: 500; opacity: 0.8; }
  .hdr__lang:hover { opacity: 1; color: var(--brass); }
  .hdr__reserve { padding: 0.85em 1.5em; }
  .hdr__toggle { display: flex; align-items: center; gap: 0.8rem; font-size: 0.75rem; letter-spacing: 0.2em; text-transform: uppercase; font-weight: 500; }
  .hdr__burger { position: relative; width: 28px; height: 10px; }
  .hdr__burger i { position: absolute; left: 0; right: 0; height: 1px; background: currentColor; transition: transform 0.6s var(--ease), top 0.6s var(--ease); }
  .hdr__burger i:first-child { top: 0; }
  .hdr__burger i:last-child { top: 9px; }
  [aria-expanded='true'] .hdr__burger i:first-child { top: 5px; transform: rotate(20deg); }
  [aria-expanded='true'] .hdr__burger i:last-child { top: 5px; transform: rotate(-20deg); }
  @media (max-width: 560px) {
    .hdr__toggle-label { display: none; }
    .hdr__reserve { padding: 0.75em 1.1em; font-size: 0.68rem; }
  }

  .nav { position: fixed; inset: 0; z-index: 95; }
  .nav[hidden] { display: none; }
  .nav__bg {
    position: absolute; inset: 0; background: var(--night-2);
    clip-path: inset(0 0 100% 0 round 0 0 50% 50%);
  }
  .nav__bg::after {
    content: ''; position: absolute; inset: 0; opacity: 0.06;
    background: url('/brand/emblem-cream.svg') center / 120% auto no-repeat;
  }
  .nav__inner {
    position: relative; height: 100%;
    display: grid; grid-template-columns: 1.3fr 1fr; grid-template-rows: 1fr auto;
    gap: 2rem 4rem; padding-top: calc(var(--header-h) + 3vh); padding-bottom: 2rem;
  }
  .nav__list ol { list-style: none; padding: 0; display: grid; gap: 0.2em; align-content: center; height: 100%; }
  .nav__list a { display: grid; grid-template-columns: 3rem auto 1fr; align-items: baseline; gap: 1rem; padding: 0.15em 0; }
  .nav__num { font-size: 0.72rem; letter-spacing: 0.2em; color: var(--brass); }
  .nav__label { font-size: clamp(2.6rem, 7vw, 6.4rem); transition: font-style 0.3s, color 0.4s, transform 0.6s var(--ease); display: inline-block; }
  .nav__list a:hover .nav__label, .nav__list a[aria-current] .nav__label { font-style: italic; color: var(--brass-2); transform: translateX(0.15em); }
  .nav__ar { font-size: clamp(1.2rem, 2vw, 2rem); color: var(--damask); opacity: 0; transition: opacity 0.5s; justify-self: start; }
  .nav__list a:hover .nav__ar { opacity: 1; }
  .nav__visual { position: relative; align-self: center; aspect-ratio: 3 / 4; max-height: 72vh; width: 100%; justify-self: end; max-width: 460px; }
  .nav__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transform: scale(1.08); transition: opacity 0.8s var(--ease), transform 1.4s var(--ease); }
  .nav__img.is-on { opacity: 1; transform: scale(1); }
  .nav__foot { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 1rem 2.5rem; align-items: center; font-size: 0.9rem; color: var(--cream-dim); border-top: 1px solid var(--cream-faint); padding-top: 1.5rem; }
  .nav__foot .btn { margin-left: auto; }
  @media (max-width: 900px) {
    .nav__inner { grid-template-columns: 1fr; }
    .nav__visual { display: none; }
    .nav__foot .btn { margin-left: 0; }
  }
</style>
