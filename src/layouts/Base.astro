---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t, type Lang, type RouteKey } from '../i18n/ui';

interface Props {
  lang: Lang;
  page: RouteKey;
  title: string;
  description: string;
  image?: string;
  jsonLd?: Record<string, unknown>[];
  intro?: boolean;
}
const { lang, page, title, description, image, jsonLd, intro = false } = Astro.props;
---
<!doctype html>
<html lang={lang === 'fr' ? 'fr-CA' : 'en-CA'} data-page={page}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#120a0d" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Seo lang={lang} page={page} title={title} description={description} image={image} jsonLd={jsonLd} />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body data-has-intro={intro ? 'true' : undefined}>
    <a class="skip" href="#main">{t[lang].skip}</a>
    <Header lang={lang} page={page} />
    <slot name="intro" />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <div class="grain" aria-hidden="true"></div>
    <div class="lantern" aria-hidden="true" data-lantern></div>
    <div class="cursor-dot" aria-hidden="true" data-cursor-dot></div>
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
