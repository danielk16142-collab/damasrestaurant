---
import Base from '../../layouts/Base.astro';
import View from '../../views/Events.astro';
import { meta, breadcrumb } from '../../data/seo';
const lang = 'en' as const;
const page = 'events' as const;
const m = meta[page][lang];
const jsonLd = [breadcrumb(page, lang)].filter(Boolean) as Record<string, unknown>[];
---
<Base lang={lang} page={page} title={m.title} description={m.description} jsonLd={jsonLd}>
  <View lang={lang} />
</Base>
