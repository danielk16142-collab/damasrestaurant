---
import Base from '../layouts/Base.astro';
import View from '../views/Home.astro';
import { meta, breadcrumb } from '../data/seo';
const lang = 'fr' as const;
const page = 'home' as const;
const m = meta[page][lang];
const jsonLd = [breadcrumb(page, lang)].filter(Boolean) as Record<string, unknown>[];
---
<Base lang={lang} page={page} title={m.title} description={m.description} jsonLd={jsonLd} intro>
  <View lang={lang} />
</Base>
