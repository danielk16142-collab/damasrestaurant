  .voyage__price small { font-family: var(--font-body); font-size: var(--step--2); letter-spacing: 0.16em; text-transform: uppercase; color: var(--mist); }
  .voyage__card p.muted { max-width: 52ch; }
  .voyage__tilde { width: 60px; color: var(--brass); }
  .pairings { width: 100%; max-width: 26rem; display: grid; gap: 0.5rem; text-align: left; }
  .pairings li { display: flex; align-items: baseline; gap: 0.5rem; font-family: var(--font-display); font-size: var(--step-1); }
  .pairings__dots { flex: 1; border-bottom: 1px dotted var(--line-dark); transform: translateY(-0.3em); min-width: 1rem; }
  .voyage__cta { display: flex; flex-wrap: wrap; gap: 1rem 2rem; justify-content: center; align-items: center; margin-top: 1rem; }
  @media (max-width: 800px) { .voyage__grid { grid-template-columns: 1fr; } .voyage__img { width: 100%; justify-self: center; } }

  /* Le bar et la cave */
  .bar { background: linear-gradient(var(--ink), var(--ink-2)); overflow: hidden; }
  .marquee { overflow: hidden; border-block: 1px solid var(--line-dark); padding-block: 1.5rem; }
  .marquee__row { display: flex; width: max-content; animation: marquee 60s linear infinite; }
  .marquee:hover .marquee__row { animation-play-state: paused; }
  .marquee__row span { display: flex; align-items: center; gap: 2.5rem; padding-right: 2.5rem; font-family: var(--font-display); font-size: var(--step-5); white-space: nowrap; line-height: 1.2; }
  .marquee__row em { color: transparent; -webkit-text-stroke: 1px var(--accent); font-style: italic; }
  .marquee__row i { font-style: normal; font-size: 0.35em; color: var(--damask); }
  @keyframes marquee { to { transform: translateX(-50%); } }
  .bar__grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 2rem; align-items: start; }
  .bar__text { grid-column: 1 / span 5; display: grid; gap: 1.25rem; align-self: center; }
  .bar__text h2 { font-size: var(--step-5); }
  .bar__text p { max-width: 46ch; }
  .bar__a { grid-column: 7 / span 4; aspect-ratio: 3 / 4; }
  .bar__b { grid-column: 11 / span 2; aspect-ratio: 2 / 3; margin: 8rem 0 0; }
  .cellar { grid-column: 2 / span 10; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: clamp(2rem, 5vw, 5rem); margin-top: clamp(4rem, 8vw, 7rem); align-items: center; }
  .cellar__img { aspect-ratio: 4 / 5; }
  .cellar__text { display: grid; gap: 1rem; justify-items: start; }
  .cellar__list { width: 100%; margin-bottom: 1rem; }
