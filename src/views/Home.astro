  :global(.tale__rosette) { width: 56px; color: var(--damask); }
  @media (prefers-reduced-motion: reduce) { .marquee__row { animation: none; } }
</style>

<script>
  import { gsap, ScrollTrigger } from '../scripts/motion';
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // P3: the signature list previews each dish; the photo follows the pointer
  const sig = document.querySelector<HTMLElement>('[data-sig]');
  const float = sig?.querySelector<HTMLElement>('.sig__float');
  if (sig && float && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    const imgs = float.querySelectorAll<HTMLElement>('[data-sig-img]');
    const xTo = gsap.quickTo(float, 'x', { duration: 0.6, ease: 'power3.out' });
    const yTo = gsap.quickTo(float, 'y', { duration: 0.6, ease: 'power3.out' });
    sig.querySelectorAll<HTMLElement>('[data-sig-row]').forEach((row) => {
      row.addEventListener('pointerenter', () => {
        float.classList.add('is-on');
        imgs.forEach((im) => im.classList.toggle('is-on', im.dataset.sigImg === row.dataset.sigRow));
      });
    });
    sig.addEventListener('pointermove', (e) => { xTo(e.clientX + 24); yTo(e.clientY - 140); });
    sig.addEventListener('pointerleave', () => float.classList.remove('is-on'));
  }

  // T6: the marquee speeds up with the scroll, then settles
  const row = document.querySelector<HTMLElement>('[data-marquee] .marquee__row');
  if (row && !reduce) {
    const anim = row.getAnimations()[0];
    if (anim) {
      ScrollTrigger.create({
        trigger: row, start: 'top bottom', end: 'bottom top', refreshPriority: -1,
        onUpdate: (self) => {
          const v = Math.min(Math.abs(self.getVelocity()) / 500, 4);
          anim.playbackRate = 1 + v;
          clearTimeout((row as any)._t);
          (row as any)._t = setTimeout(() => (anim.playbackRate = 1), 250);
        },
      });
    }
  }

  // The salon doors open (I10)
  const salons = document.querySelector<HTMLElement>('[data-salons]');
  if (salons && !reduce) {
    gsap.fromTo(salons, { clipPath: 'inset(8% 8% 20% 8% round 45vw 45vw 0vw 0vw)' }, {
      clipPath: 'inset(0% 0% 0% 0% round 0vw 0vw 0vw 0vw)', ease: 'none',
      scrollTrigger: { trigger: salons.parentElement, start: 'top 85%', end: 'center center', scrub: 0.8, refreshPriority: -1 },
    });
  }
</script>
