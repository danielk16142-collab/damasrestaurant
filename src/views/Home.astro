  .sig__float { position: fixed; left: 0; top: 0; z-index: 5; width: 16rem; aspect-ratio: 4 / 5; pointer-events: none; border-radius: 50% 50% 0 0 / 28% 28% 0 0; overflow: hidden; opacity: 0; transform: scale(0.85); transition: opacity 0.4s, transform 0.6s var(--ease-out); }
