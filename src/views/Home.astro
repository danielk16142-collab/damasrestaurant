---
import { Image, Picture } from 'astro:assets';
import { routes, t, type Lang } from '../i18n/ui';
import { site } from '../data/site';
import { tasting, dinner, drinks, levantWines, araks, winePdf, type L } from '../data/menus';
import Rosette from '../components/Rosette.astro';

import heroImg from '../assets/photos/salon-lanternes.jpg';
import salleSoir from '../assets/photos/salle-soir.jpg';
import moucharabieh from '../assets/photos/moucharabieh.jpg';
import sallePlafond from '../assets/photos/salle-plafond.jpg';
import longueTable from '../assets/photos/longue-table.jpg';
import mezzesCuivre from '../assets/photos/mezzes-cuivre.jpg';
import fattouch from '../assets/photos/fattouch.avif';
import hummus from '../assets/photos/hummus.jpg';
import kibbeh from '../assets/photos/kibbeh.jpg';
import halloumi from '../assets/photos/halloumi.jpg';
import faconnage from '../assets/photos/kibbeh-faconnage.jpg';
import fourPain from '../assets/photos/four-pain.jpg';
import braise from '../assets/photos/braise-poisson.jpg';
import boeufSauce from '../assets/photos/boeuf-sauce.avif';
import poissonHerbes from '../assets/photos/poisson-herbes.jpg';
import freekeh from '../assets/photos/mijote-freekeh.jpg';
import cocktailRose from '../assets/photos/cocktail-rose.jpg';
import barman from '../assets/photos/barman.jpg';
import bargylus from '../assets/photos/bargylus.avif';
import brunchOeufs from '../assets/photos/brunch-oeufs.jpg';
import brunchBoeuf from '../assets/photos/brunch-boeuf.jpg';
import events from '../assets/photos/evenements-prives.avif';
import douceur from '../assets/photos/douceur-pistache.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t[lang];
const fr = lang === 'fr';
const tr = (x: L) => x[lang];

const nights = [
  { roman: 'I', ar: '١' }, { roman: 'II', ar: '٢' }, { roman: 'III', ar: '٣' }, { roman: 'IV', ar: '٤' },
  { roman: 'V', ar: '٥' }, { roman: 'VI', ar: '٦' }, { roman: 'VII', ar: '٧' },
];

const mezzes = [
  { img: mezzesCuivre, ar: 'مازة', name: { fr: 'Plateau de mezzés du chef', en: "Chef's mezzes platter" }, note: { fr: "Hummus, mouhammara, mutabbal de betterave, mutabbal d'aubergine", en: 'Hummus, mouhammara, beet mutabbal, eggplant mutabbal' } },
  { img: fattouch, ar: 'فتوش', name: { fr: 'Salade fattouch', en: 'Fattouch salad' }, note: { fr: 'Mezzé froid', en: 'Cold mezze' } },
  { img: hummus, ar: 'حمّص', name: { fr: 'Hummus', en: 'Hummus' }, note: { fr: 'Le cœur de toute table syrienne', en: 'The heart of every Syrian table' } },
  { img: kibbeh, ar: 'كبّة', name: { fr: 'Kibbeh aux pistaches', en: 'Pistachio kibbeh' }, note: { fr: 'Mutabbal de betterave', en: 'Beet mutabbal' } },
  { img: faconnage, ar: 'باليد', name: { fr: 'Façonnées à la main', en: 'Shaped by hand' }, note: { fr: 'Une à une, en cuisine, chaque soir', en: 'One by one, in the kitchen, every evening' } },
  { img: halloumi, ar: 'حلّوم', name: { fr: 'Halloumi grillé', en: 'Grilled halloumi' }, note: { fr: 'Mezzé chaud', en: 'Hot mezze' } },
  { img: fourPain, ar: 'خبز', name: { fr: 'Le four à pain', en: 'The bread oven' }, note: { fr: 'Le pain gonfle et arrive brûlant', en: 'The bread puffs up and arrives piping hot' } },
];

const grillIds = ["Carré d'agneau", 'Kebab de filet mignon', 'Daurade rose rôtie façon samké harra', 'Grillades mixtes pour deux', "Kebab d'agneau à l'aubergine"];
const grills = dinner.sections.find((x) => x.id === 'specialites')!.items.filter((i) => grillIds.includes(i.name.fr));
const cocktailNames = drinks.sections.find((x) => x.id === 'cocktails')!.items.map((i) => tr(i.name));

const c = fr
  ? {
      introLine: 'Il était une fois, à Damas…',
      heroEyebrow: 'Cuisine syrienne · Outremont, Montréal',
      heroTitle: ['Une nuit', 'à Damas'],
      heroSr: 'Damas, restaurant syrien à Montréal — ',
      heroSide: 'Un conte des Mille et Une Nuits, servi chaque soir avenue Van Horne.',
      ch1: 'La Maison',
      manifesto:
        'Depuis 2010, Damas raconte la Syrie à Montréal. Velours, bois sculpté, lanternes de cuivre et lumières de toutes les couleurs : chaque soir, la salle devient un conte des Mille et Une Nuits — et la table, son plus beau chapitre.',
      chefTitle: 'Le regard du chef',
      chefText:
        'Chef et copropriétaire, Fuad Alnirabie a imaginé Damas comme une ode à sa Syrie natale : les saveurs intemporelles de Damas et d’Alep, relues avec un regard contemporain. Un dialogue entre héritage et imagination.',
      facts: [
        { n: '2010', l: 'Première nuit' },
        { n: '2015', l: 'Avenue Van Horne' },
        { n: '100', l: 'Places en salle' },
        { n: '70', l: 'Places en terrasse' },
      ],
      ch2: 'La Table',
      mezzeTitle: ['Le partage', 'des mezzés'],
      mezzeText: 'À la syrienne, tout commence au centre de la table : une succession de petits plats froids et chauds que l’on partage, que l’on se passe, dont on reparle.',
      ch3: 'La Braise',
      grillTitle: ['Sur le', 'charbon de bois'],
      grillText: 'Agneau, bœuf Canadian Prime, poissons entiers : les grillades prennent le temps de la braise, comme dans les maisons de Damas.',
      ch4: 'Le Voyage',
      tastingTitle: ['Menu', 'dégustation'],
      ch5: 'Le Bar & la Cave',
      barTitle: ['Rose de Damas,', 'piment d’Alep'],
      barText: 'Au bar, le garde-manger syrien se verse au verre : safran, cardamome, eau de rose, abricot Qamar al-Din. À la cave, une sélection généreuse où figurent les rares vins de Syrie et du Liban.',
      levant: 'Vins du Levant',
      arak: 'Araks',
      ch6: 'Le Brunch',
      brunchTitle: ['Quand la maison', 's’éveille'],
      brunchText: 'Le samedi et le dimanche, Damas se réveille autour du mezzé matinal du chef, de la casserole d’œufs menemen et du pain doré au halva.',
      brunchCta: 'Menu brunch',
      ch7: 'Les Salons',
      eventsTitle: ['Vos soirées,', 'nos salons'],
      eventsText: 'Anniversaires, repas d’affaires, fêtes de famille : la longue table et les salons de Damas accueillent vos grandes occasions, avec un menu pensé pour le partage.',
      eventsCta: 'Événements privés',
      honours: 'Distinctions',
      sweetTitle: 'Et pour finir, une douceur.',
    }
  : {
      introLine: 'Once upon a time, in Damascus…',
      heroEyebrow: 'Syrian cuisine · Outremont, Montréal',
      heroTitle: ['A night', 'in Damascus'],
      heroSr: 'Damas, Syrian restaurant in Montreal — ',
      heroSide: 'A tale from the Thousand and One Nights, served every evening on Van Horne Avenue.',
      ch1: 'The House',
      manifesto:
        'Since 2010, Damas has been telling the story of Syria in Montreal. Velvet, carved wood, copper lanterns and light in every colour: each evening, the room becomes a tale from the Thousand and One Nights — and the table, its finest chapter.',
      chefTitle: "The chef's vision",
      chefText:
        'Chef and co-owner Fuad Alnirabie imagined Damas as an ode to his native Syria: the timeless flavours of Damascus and Aleppo, seen through a contemporary eye. A dialogue between heritage and imagination.',
      facts: [
        { n: '2010', l: 'The first night' },
        { n: '2015', l: 'Van Horne Avenue' },
        { n: '100', l: 'Seats indoors' },
        { n: '70', l: 'Seats on the terrace' },
      ],
      ch2: 'The Table',
      mezzeTitle: ['The art', 'of mezze'],
      mezzeText: 'The Syrian way, everything begins at the centre of the table: a procession of small hot and cold dishes to share, to pass around, to talk about.',
      ch3: 'The Embers',
      grillTitle: ['Over', 'charcoal'],
      grillText: 'Lamb, Canadian Prime beef, whole fish: the grills take their time over the embers, as they do in the homes of Damascus.',
      ch4: 'The Journey',
      tastingTitle: ['Tasting', 'menu'],
      ch5: 'Bar & Cellar',
      barTitle: ['Damascus rose,', 'Aleppo pepper'],
      barText: 'At the bar, the Syrian pantry is poured by the glass: saffron, cardamom, rosewater, Qamar al-Din apricot. In the cellar, a generous list that includes rare wines from Syria and Lebanon.',
      levant: 'Wines of the Levant',
      arak: 'Araks',
      ch6: 'Brunch',
      brunchTitle: ['When the house', 'wakes up'],
      brunchText: "On Saturdays and Sundays, Damas wakes up to the chef's morning mezze, the menemen egg casserole and halva French toast.",
      brunchCta: 'Brunch menu',
      ch7: 'The Salons',
      eventsTitle: ['Your evenings,', 'our salons'],
      eventsText: "Birthdays, business dinners, family celebrations: Damas's long table and salons host your great occasions, with a menu made for sharing.",
      eventsCta: 'Private events',
      honours: 'Honours',
      sweetTitle: 'And to finish, something sweet.',
    };
---

<!-- ═════════ Threshold (intro) ═════════ -->
<div class="intro" data-intro aria-hidden="true">
  <div class="intro__stage">
    <div class="intro__lockup">
      <img class="intro__emblem" src="/brand/emblem-red.svg" alt="" width="895" height="658" fetchpriority="high" />
      <img class="intro__word" src="/brand/wordmark-cream.svg" alt="" width="540" height="169" />
    </div>
    <p class="intro__line display"><em>{c.introLine}</em></p>
  </div>
  <button class="intro__skip" data-intro-skip tabindex="-1">{s.skipIntro}</button>
</div>

<!-- ═════════ Hero ═════════ -->
<section class="hero" data-hero>
  <div class="hero__sticky">
    <div class="hero__window" data-hero-window>
      <Picture src={heroImg} formats={['avif', 'webp']} alt={fr ? 'Salon de Damas éclairé par des lustres de perles et de cristal' : 'A Damas salon lit by beaded crystal chandeliers'} widths={[640, 1024, 1536, 2048]} sizes="100vw" loading="eager" fetchpriority="high" class="hero__img" />
      <div class="hero__shade"></div>
    </div>
    <div class="hero__content wrap">
      <p class="eyebrow hero__eyebrow" data-hero-fade>{c.heroEyebrow}</p>
      <h1 class="display h-xxl hero__title">
        <span class="sr-only">{c.heroSr}</span>
        <span class="hero__l1" data-hero-line>{c.heroTitle[0]}</span>
        <em class="hero__l2" data-hero-line>{c.heroTitle[1]}</em>
      </h1>
      <div class="hero__meta" data-hero-fade>
        <p>{c.heroSide}</p>
        <p class="hero__award"><span class="eyebrow">Guide MICHELIN</span> Bib Gourmand 2025</p>
      </div>
      <div class="hero__scroll" data-hero-fade aria-hidden="true"><span>{s.scroll}</span><i></i></div>
    </div>
  </div>
</section>

<!-- ═════════ Night I — The House ═════════ -->
<section class="ch ch--house" data-chapter="0" id="la-maison">
  <div class="wrap">
    <header class="ch__head">
      <span class="ch__num"><span class="arabic">{nights[0].ar}</span> {s.night} {nights[0].roman}</span>
      <h2 class="eyebrow">{c.ch1}</h2>
    </header>
    <p class="manifesto display" data-reveal="scrub">{c.manifesto}</p>

    <div class="house">
      <figure class="house__a arch" data-reveal="arch">
        <Image src={moucharabieh} alt={fr ? 'Salle aux murs rayés et moucharabieh lumineux' : 'Striped walls and a glowing mashrabiya window'} widths={[480, 800, 1100]} sizes="(max-width: 800px) 90vw, 36vw" />
      </figure>
      <div class="house__text">
        <Rosette class="house__rosette" />
        <h3 class="display h-m" data-reveal="line">{c.chefTitle}</h3>
        <p class="muted" data-reveal="fade">{c.chefText}</p>
        <p class="house__sig display" data-reveal="fade"><em>— {site.chef}</em></p>
      </div>
      <figure class="house__b" data-reveal="fade">
        <div class="house__b-in" data-parallax="14">
          <Image src={sallePlafond} alt={fr ? 'Plafond rouge constellé de lanternes' : 'Red ceiling studded with lanterns'} widths={[640, 1000, 1440]} sizes="(max-width: 800px) 90vw, 46vw" />
        </div>
      </figure>
      <figure class="house__c arch-soft" data-reveal="arch">
        <Image src={longueTable} alt={fr ? 'La longue table dressée sous les lustres' : 'The long table set beneath the chandeliers'} widths={[400, 700]} sizes="(max-width: 800px) 60vw, 22vw" />
      </figure>
    </div>

    <ul class="facts">
      {c.facts.map((f) => (
        <li data-reveal="fade"><span class="display facts__n">{f.n}</span><span class="facts__l">{f.l}</span></li>
      ))}
    </ul>
  </div>
</section>

<!-- ═════════ Night II — Mezzes (horizontal) ═════════ -->
<section class="ch ch--mezze" data-chapter="1" id="mezzes" data-mezze>
  <div class="mezze__pin" data-mezze-pin>
    <div class="mezze__track" data-mezze-track>
      <div class="mezze__intro">
        <span class="ch__num"><span class="arabic">{nights[1].ar}</span> {s.night} {nights[1].roman} · {c.ch2}</span>
        <h2 class="display h-xl" data-reveal="line">{c.mezzeTitle[0]} <em>{c.mezzeTitle[1]}</em></h2>
        <p class="muted" data-reveal="fade">{c.mezzeText}</p>
      </div>
      {mezzes.map((m, i) => (
        <figure class="dish" data-dish>
          <div class:list={['dish__img', i % 2 ? 'arch-soft' : 'arch']}>
            <Image src={m.img} alt={tr(m.name)} widths={[420, 700, 960]} sizes="(max-width: 800px) 76vw, 30vw" loading="lazy" />
          </div>
          <figcaption>
            <span class="dish__ar arabic" aria-hidden="true">{m.ar}</span>
            <span class="dish__n">{String(i + 1).padStart(2, '0')}</span>
            <strong class="display">{tr(m.name)}</strong>
            <span class="muted">{tr(m.note)}</span>
          </figcaption>
        </figure>
      ))}
      <div class="mezze__end">
        <a class="btn" href={`${routes.menus[lang]}#diner`}>{s.viewMenus}</a>
      </div>
    </div>
  </div>
</section>

<!-- ═════════ Night III — Embers ═════════ -->
<section class="ch ch--grill" data-chapter="2" id="la-braise">
  <div class="grill__bg">
    <div class="grill__bg-in" data-parallax="18">
      <Image src={braise} alt={fr ? 'Poisson entier grillé sur le charbon de bois' : 'Whole fish grilling over charcoal'} widths={[800, 1280, 1800]} sizes="100vw" loading="lazy" />
    </div>
    <canvas class="grill__embers" data-embers aria-hidden="true"></canvas>
  </div>
  <div class="wrap grill__grid">
    <div class="grill__text">
      <span class="ch__num"><span class="arabic">{nights[2].ar}</span> {s.night} {nights[2].roman} · {c.ch3}</span>
      <h2 class="display h-xl" data-reveal="line">{c.grillTitle[0]} <em>{c.grillTitle[1]}</em></h2>
      <p data-reveal="fade">{c.grillText}</p>
    </div>
    <ul class="grill__list">
      {grills.map((g) => (
        <li data-reveal="fade">
          <span class="display">{tr(g.name)}</span>
          {g.desc && <span class="muted">{tr(g.desc)}</span>}
        </li>
      ))}
    </ul>
    <figure class="grill__side arch" data-reveal="arch">
      <Image src={boeufSauce} alt={fr ? 'Sauce versée sur une pièce de bœuf grillée' : 'Sauce poured over grilled beef'} widths={[480, 800]} sizes="(max-width: 800px) 70vw, 26vw" loading="lazy" />
    </figure>
    <figure class="grill__side2 arch-soft" data-reveal="arch">
      <Image src={poissonHerbes} alt={fr ? 'Poisson aux herbes dans un plat de fonte ouvragé' : 'Herb-crusted fish in an engraved cast-iron dish'} widths={[400, 700]} sizes="(max-width: 800px) 60vw, 20vw" loading="lazy" />
    </figure>
  </div>
</section>

<!-- ═════════ Night IV — Tasting ═════════ -->
<section class="ch ch--tasting" data-chapter="3" id="degustation">
  <div class="wrap tasting">
    <figure class="tasting__img arch" data-reveal="arch">
      <Image src={freekeh} alt={fr ? 'Viande mijotée sur freekeh, pistaches et menthe' : 'Braised meat over freekeh with pistachios and mint'} widths={[500, 900, 1200]} sizes="(max-width: 800px) 90vw, 40vw" loading="lazy" />
    </figure>
    <div class="tasting__card" data-reveal="fade">
      <span class="ch__num"><span class="arabic">{nights[3].ar}</span> {s.night} {nights[3].roman} · {c.ch4}</span>
      <h2 class="display h-l">{c.tastingTitle[0]} <em>{c.tastingTitle[1]}</em></h2>
      <p class="tasting__price display"><span>{tasting.price}</span> <small>$ {tr(tasting.per)}</small></p>
      <p class="muted">{tr(tasting.text)}</p>
      <svg class="tilde" viewBox="0 0 60 12" aria-hidden="true" data-draw><path d="M2 8 C 14 -2, 22 14, 30 6 S 46 -2, 58 6" fill="none" stroke="currentColor" stroke-width="1.2" /></svg>
      <ul class="pairings">
        {tasting.pairings.map((p) => (<li><span>{tr(p.name)}</span><span class="dots"></span><span>+ {p.price}</span></li>))}
      </ul>
      <div class="tasting__cta">
        <a class="btn btn--solid" href={site.reservationUrl} target="_blank" rel="noopener">{s.reserveLong}</a>
        <a class="btn" href={`${routes.menus[lang]}#degustation`}>{s.viewMenus}</a>
      </div>
    </div>
  </div>
</section>

<!-- ═════════ Night V — Bar & Cellar ═════════ -->
<section class="ch ch--bar" data-chapter="4" id="bar">
  <div class="marquee" aria-hidden="true">
    <div class="marquee__row display" data-marquee>
      {[0, 1].map(() => (
        <span>{cocktailNames.map((n) => (<><em>{n}</em><img src="/brand/emblem-red.svg" alt="" width="60" height="44" loading="lazy" /></>))}</span>
      ))}
    </div>
  </div>
  <div class="wrap bar">
    <div class="bar__text">
      <span class="ch__num"><span class="arabic">{nights[4].ar}</span> {s.night} {nights[4].roman} · {c.ch5}</span>
      <h2 class="display h-l" data-reveal="line">{c.barTitle[0]} <em>{c.barTitle[1]}</em></h2>
      <p class="muted" data-reveal="fade">{c.barText}</p>
    </div>
    <figure class="bar__a arch" data-reveal="arch">
      <Image src={cocktailRose} alt={fr ? 'Cocktail aux pétales de rose' : 'Cocktail garnished with rose petals'} widths={[480, 800]} sizes="(max-width: 800px) 70vw, 28vw" loading="lazy" />
    </figure>
    <figure class="bar__b" data-reveal="fade">
      <div data-parallax="12"><Image src={barman} alt={fr ? 'Le barman verse un cocktail' : 'The bartender pouring a cocktail'} widths={[400, 700]} sizes="(max-width: 800px) 60vw, 22vw" loading="lazy" /></div>
    </figure>
    <div class="cellar" data-reveal="fade">
      <figure class="cellar__img arch-soft">
        <Image src={bargylus} alt={fr ? 'Bouteilles de Bargylus, vin de Syrie' : 'Bottles of Bargylus, a Syrian wine'} widths={[400, 760]} sizes="(max-width: 800px) 70vw, 22vw" loading="lazy" />
      </figure>
      <div>
        <h3 class="eyebrow">{c.levant}</h3>
        <ul class="cellar__list">
          {levantWines.map((w) => (<li><span class="display">{w.name}</span><span class="muted">{w.grapes} · {tr(w.origin)}</span></li>))}
        </ul>
        <h3 class="eyebrow">{c.arak}</h3>
        <p class="muted">{araks.join(' · ')}</p>
        <a class="btn" href={winePdf} target="_blank" rel="noopener">{s.wineList} ↓</a>
      </div>
    </div>
  </div>
</section>

<!-- ═════════ Night VI — Brunch ═════════ -->
<section class="ch ch--brunch" data-chapter="5" id="brunch">
  <div class="wrap brunch">
    <figure class="brunch__a arch" data-reveal="arch">
      <Image src={brunchOeufs} alt={fr ? 'Faux-filet et œufs ottomans au brunch' : 'Ribeye and Ottoman eggs at brunch'} widths={[480, 800, 1100]} sizes="(max-width: 800px) 80vw, 34vw" loading="lazy" />
    </figure>
    <div class="brunch__text">
      <span class="ch__num"><span class="arabic">{nights[5].ar}</span> {s.night} {nights[5].roman} · {c.ch6}</span>
      <h2 class="display h-l" data-reveal="line">{c.brunchTitle[0]} <em>{c.brunchTitle[1]}</em></h2>
      <p class="muted" data-reveal="fade">{c.brunchText}</p>
      <p class="brunch__hours" data-reveal="fade"><span class="eyebrow">{s.brunchDays}</span> 10 h – 14 h</p>
      <a class="btn" href={`${routes.menus[lang]}#brunch`} data-reveal="fade">{c.brunchCta}</a>
    </div>
    <figure class="brunch__b" data-reveal="fade">
      <div data-parallax="16"><Image src={brunchBoeuf} alt="" widths={[400, 700]} sizes="(max-width: 800px) 50vw, 20vw" loading="lazy" /></div>
    </figure>
  </div>
</section>

<!-- ═════════ Night VII — Salons / Private events ═════════ -->
<section class="ch ch--events" data-chapter="6" id="salons">
  <div class="events__media" data-events-media>
    <Image src={events} alt={fr ? 'Salon privé dressé pour une longue tablée sous des lustres de cristal' : 'Private salon set for a long table under crystal chandeliers'} widths={[800, 1280, 1772]} sizes="100vw" loading="lazy" />
  </div>
  <div class="wrap events__text">
    <span class="ch__num"><span class="arabic">{nights[6].ar}</span> {s.night} {nights[6].roman} · {c.ch7}</span>
    <h2 class="display h-xl" data-reveal="line">{c.eventsTitle[0]} <em>{c.eventsTitle[1]}</em></h2>
    <p data-reveal="fade">{c.eventsText}</p>
    <a class="btn btn--solid" href={routes.events[lang]} data-reveal="fade">{c.eventsCta}</a>
  </div>
</section>

<!-- ═════════ Honours + sweet ending ═════════ -->
<section class="honours">
  <div class="wrap honours__grid">
    <div>
      <h2 class="eyebrow">{c.honours}</h2>
      <ul class="honours__list">
        {site.awards.map((a) => (<li data-reveal="fade"><span class="display">{a[lang]}</span>{a.year && <span class="muted">{a.year}</span>}</li>))}
      </ul>
    </div>
    <figure class="honours__img arch" data-reveal="arch">
      <Image src={douceur} alt={fr ? 'Pâtisserie à la pistache et crème glacée' : 'Pistachio pastry with ice cream'} widths={[400, 700]} sizes="(max-width: 800px) 70vw, 26vw" loading="lazy" />
      <figcaption class="display"><em>{c.sweetTitle}</em></figcaption>
    </figure>
  </div>
</section>

<div class="chapter-ind" data-chapter-ind aria-hidden="true">
