  @media (max-width: 800px) {
    .bar__grid { grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: 1.5rem 1rem; }
    .bar__text { grid-column: 1 / -1; }
    .bar__a { grid-column: 1; }
    .bar__b { grid-column: 2; margin-top: 5rem; }
    .cellar { grid-column: 1 / -1; grid-template-columns: 1fr; }
