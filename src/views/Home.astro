---
// Home: "Une nuit à Damas". The evening unfolds hour by hour; each chapter is a
// room of the house. Copy builds on Damas's own words from damas.ca.
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Intro from '../components/Intro.astro';
import ArchHero from '../components/ArchHero.astro';
import SideIndex from '../components/SideIndex.astro';
import Embers from '../components/Embers.astro';
import Rosette from '../components/Rosette.astro';
import { site } from '../lib/content';
import { dinner, drinks, tasting, levantWines, araks } from '../lib/menus';
import { url, useT, type Lang } from '../lib/i18n';
import type { L } from '../lib/menus';

import heroImg from '../assets/photos/salle-principale.jpg';
import moucharabieh from '../assets/photos/moucharabieh.jpg';
import sallePlafond from '../assets/photos/salle-plafond.jpg';
import longueTable from '../assets/photos/longue-table.jpg';
import mezzesCuivre from '../assets/photos/mezzes-cuivre.jpg';
import fattouch from '../assets/photos/fattouch.avif';
import hummus from '../assets/photos/hummus.jpg';
import kibbeh from '../assets/photos/kibbeh.jpg';
import faconnage from '../assets/photos/kibbeh-faconnage.jpg';
import halloumi from '../assets/photos/halloumi.jpg';
import fourPain from '../assets/photos/four-pain.jpg';
import tomates from '../assets/photos/tomates-farcies.avif';
import braise from '../assets/photos/braise-poisson.jpg';
import carre from '../assets/photos/boeuf-sauce.avif';
import filet from '../assets/photos/boeuf-pain.webp';
import samke from '../assets/photos/poisson-herbes.jpg';
import grillades from '../assets/photos/table-partage.jpg';
import kebabAgneau from '../assets/photos/mijote-freekeh.jpg';
import freekeh from '../assets/photos/moujaddara.avif';
import cocktailRose from '../assets/photos/cocktail-rose.jpg';
import barman from '../assets/photos/barman.jpg';
import bargylus from '../assets/photos/bargylus.avif';
import brunchOeufs from '../assets/photos/brunch-oeufs.jpg';
import brunchBoeuf from '../assets/photos/brunch-boeuf.jpg';
import salons from '../assets/photos/evenements-prives.avif';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const fr = lang === 'fr';
const tr = (x: L) => x[lang];

const mezzes = [
  { img: mezzesCuivre, ar: 'مازة', name: { fr: 'Plateau de mezzés du chef', en: "Chef's mezzes platter" }, note: { fr: 'Hummus, mouhammara, mutabbal de betterave et d’aubergine', en: 'Hummus, mouhammara, beet and eggplant mutabbal' } },
  { img: fattouch, ar: 'فتّوش', name: { fr: 'Salade fattouch', en: 'Fattouch salad' }, note: { fr: 'Mezzé froid', en: 'Cold mezze' } },
  { img: kibbeh, ar: 'كبّة', name: { fr: 'Kibbeh aux pistaches', en: 'Pistachio kibbeh' }, note: { fr: 'Mutabbal de betterave', en: 'Beet mutabbal' } },
  { img: faconnage, ar: 'باليد', name: { fr: 'Façonnées à la main', en: 'Shaped by hand' }, note: { fr: 'Une à une, en cuisine, chaque soir', en: 'One by one, in the kitchen, every evening' } },
  { img: hummus, ar: 'حمّص', name: { fr: 'Hummus', en: 'Hummus' }, note: { fr: 'Le cœur de toute table syrienne', en: 'The heart of every Syrian table' } },
  { img: halloumi, ar: 'حلّوم', name: { fr: 'Halloumi grillé', en: 'Grilled halloumi' }, note: { fr: 'Mezzé chaud', en: 'Hot mezze' } },
  { img: tomates, ar: 'مازة', name: { fr: 'Bouchées du moment', en: 'Bites of the moment' }, note: { fr: 'Pour les réceptions', en: 'For receptions' } },
  { img: fourPain, ar: 'خبز', name: { fr: 'Le four à pain', en: 'The bread oven' }, note: { fr: 'Le pain gonfle et arrive brûlant', en: 'The bread puffs up and arrives piping hot' } },
];

// Signature grills, straight from the dinner menu (P3: each row previews its photo)
const grillSection = dinner.sections.find((s) => s.id === 'specialites')!;
const pick = (fr: string) => grillSection.items.find((i) => i.name.fr === fr)!;
const signatures = [
  { dish: pick('Carré d’agneau'), img: carre },
  { dish: pick('Kebab de filet mignon'), img: filet },
  { dish: pick('Daurade rose rôtie façon samké harra'), img: samke },
  { dish: pick('Kebab d’agneau à l’aubergine'), img: kebabAgneau },
  { dish: pick('Grillades mixtes pour deux'), img: grillades },
];
const cocktails = drinks.sections.find((s) => s.id === 'cocktails')!.items.map((i) => i.name[lang]);

// Phones get the vertical shot of the same salon (art direction)
const salonsTallSrcset = (await Promise.all([480, 800, 1200].map((w) => getImage({ src: longueTable, width: w, format: 'avif' })))).map((r, i) => `${r.src} ${[480, 800, 1200][i]}w`).join(', ');

const c = fr
  ? {
      title: 'Restaurant Damas — cuisine syrienne à Outremont, Montréal',
      description: 'Une soirée syrienne enchantée à Outremont, avenue Van Horne : mezzés, grillades au charbon de bois, menu dégustation et belle cave. Bib Gourmand MICHELIN.',
      heroAlt: 'La grande salle de Damas sous son plafond rouge et ses lanternes de verre ciselé',
      h1: ['Un voyage vers la Syrie', 'le temps d’un soir'],
      lede: 'Une soirée syrienne enchantée au cœur chic et gastronomique d’Outremont, sur l’avenue Van Horne.',
      salle: {
        hour: '17 h 30', chapter: 'La salle',
        title: ['La', 'salle'],
        words: 'Au restaurant Damas, un microcosme au confort unique vous accueillera avec des couleurs chaudes, des velours, du bois sculpté et des lumières multicolores.',
        p1: 'Chez Damas, le personnage principal est sans doute cette ambiance unique. Nos habitués le savent : ils viennent s’immerger dans le climat méditerranéen et oriental depuis plusieurs années, certains de très loin.',
        p2: 'La magie de Damas tient à sa capacité de réunir des personnes d’origines différentes. Que vous soyez du Mile End ou du bout du monde, c’est vous, le héros du conte, l’ingrédient manquant.',
        figs: [['2010', 'Première nuit', true], ['100', 'Places en salle', false], ['70', 'Places en terrasse', false]],
      },
      mezze: { hour: '18 h', chapter: 'Les mezzés', title: ['Tout commence', 'au centre de la table'], text: 'Comme ailleurs en Méditerranée, la cuisine syrienne fait la part belle aux mezzés chauds et froids : de petits plats à partager entre convives, servis avant le plat principal.' },
      braise: { hour: '19 h', chapter: 'La braise', title: ['Sur le', 'charbon de bois'], text: 'Agneau, bœuf Canadian Prime, poissons entiers : les grillades prennent le temps de la braise.', list: 'Signatures' },
      voyage: { hour: '20 h', chapter: 'Le voyage', title: ['Menu', 'dégustation'] },
      bar: { hour: '21 h', chapter: 'Le bar et la cave', title: ['Safran, rose,', 'coriandre'], text: 'Nos boissons reflètent l’art ancien des épices : une touche de coriandre, une pincée de safran et de rose dans les cocktails. La culture du vin syrien est ancienne, et le vin occupe une place essentielle à la table de Damas.', levant: 'Vins du Levant', arak: 'Arak', wine: 'La carte des vins' },
      brunch: { hour: 'Le week-end', chapter: 'Le brunch', title: ['Quand la maison', 's’éveille'], text: 'Le samedi et le dimanche, de 11 h à 15 h : mezzé matinal du chef, casserole d’œufs menemen, pain doré au halva, et le four à pain qui ne s’arrête pas.', cta: 'Menu brunch' },
      salons: { hour: 'Sur demande', chapter: 'Les salons', title: ['Privatiser', 'la salle'], text: 'Certains jours, Damas peut être réservé pour vos occasions privées : réceptions d’entreprise ou célébrations personnelles, autour d’un festin à partager.', cta: 'Événements privés' },
      honours: 'Distinctions',
      tale: 'Nous aimons penser que le restaurant Damas ressemble à un conte des Mille et une Nuits : une tapisserie mystérieuse et envoûtante, et surtout invitante.',
    }
  : {
      title: 'Restaurant Damas — Syrian dining in Outremont, Montréal',
      description: 'An enchanted Syrian evening in Outremont, on Van Horne Avenue: mezze, charcoal grills, a tasting menu and a generous cellar. MICHELIN Guide Bib Gourmand.',
      heroAlt: 'The Damas main dining room beneath its red ceiling and cut-glass lanterns',
      h1: ['A journey to Syria', 'for one evening'],
      lede: 'An enchanted Syrian evening in the chic, gourmet heart of Outremont, on Van Horne Avenue.',
      salle: {
        hour: '5:30 pm', chapter: 'The room',
        title: ['The', 'room'],
        words: 'At Restaurant Damas, a uniquely comfortable microcosm greets you with warm colours, velvet, carved wood and multicoloured lights.',
        p1: 'Damas is a crossroads of Eastern and Western cultures and stories. Like the tale of a thousand and one nights, the best way to experience it is to come and immerse yourself, time and again.',
        p2: 'The true magic of Damas is how it brings people together, from across the street or across the world. Whether you come from Mile End or the end of the world, you are the hero of the tale, the missing ingredient.',
        figs: [['2010', 'The first night', true], ['100', 'Seats indoors', false], ['70', 'Seats on the terrace', false]],
      },
      mezze: { hour: '6 pm', chapter: 'Mezze', title: ['It all begins', 'at the centre of the table'], text: 'As elsewhere around the Mediterranean, Syrian cuisine favours hot and cold mezze: small dishes shared among the table, served before the main course.' },
      braise: { hour: '7 pm', chapter: 'The embers', title: ['Over', 'charcoal'], text: 'Lamb, Canadian Prime beef, whole fish: the grills take their time over the embers.', list: 'Signatures' },
      voyage: { hour: '8 pm', chapter: 'The journey', title: ['Tasting', 'menu'] },
      bar: { hour: '9 pm', chapter: 'Bar and cellar', title: ['Saffron, rose,', 'cilantro'], text: 'Our drinks reflect the ancient art of spicing: a touch of cilantro, a pinch of saffron and rose in the cocktails. Syrian wine culture is ancient, and wine is essential at the Damas table.', levant: 'Wines of the Levant', arak: 'Arak', wine: 'The wine list' },
      brunch: { hour: 'Weekends', chapter: 'Brunch', title: ['When the house', 'wakes up'], text: 'Saturday and Sunday, 11 am to 3 pm: the chef’s morning mezze, menemen egg casserole, halva French toast, and a bread oven that never stops.', cta: 'Brunch menu' },
      salons: { hour: 'On request', chapter: 'The salons', title: ['Book', 'the room'], text: 'On certain days, Damas can be booked for your private occasions, corporate or personal, around a feast made for sharing.', cta: 'Private events' },
      honours: 'Honours',
      tale: 'We like to think that Damas is reminiscent of the tale of a thousand and one nights: an abundant, mysterious and enticing tapestry, enriched by our generous cellar.',
    };
---
<Base lang={lang} page="home" title={c.title} description={c.description}>
  <Intro slot="intro" lang={lang} />

  <ArchHero image={heroImg} alt={c.heroAlt} lang={lang} eyebrow="Outremont · Montréal">
    <Fragment slot="title">{c.h1[0]}{' '}<em>{c.h1[1]}</em></Fragment>
    <Fragment slot="lede">{c.lede}</Fragment>
    <Fragment slot="actions">
      <a href={url('reserve', lang)} class="btn btn--accent">{t.reserveTable}</a>
      <a href={url('menus', lang)} class="btn btn--ghost">{t.seeMenus}</a>
    </Fragment>
    <Fragment slot="aside">
      <span class="eyebrow">{fr ? 'Guide MICHELIN' : 'MICHELIN Guide'}</span><span>Bib Gourmand 2025</span>
    </Fragment>
  </ArchHero>

  <SideIndex />

  <!-- 17 h 30 · La salle -->
  <section class="salle section" data-chapter={c.salle.chapter} data-hour={c.salle.hour} data-blooms>
    <div class="wrap">
      <header class="chap">
        <span class="chap__ar ar-accent" lang="ar" aria-hidden="true">١</span>
        <span class="chap__hour">{c.salle.hour}</span>
        <p class="eyebrow">{c.salle.chapter}</p>
      </header>
      <h2 class="sr-only">{fr ? 'La salle' : 'The room'}</h2>
      <p class="statement" data-words>{c.salle.words}</p>
      <div class="salle__grid">
        <figure class="salle__a arch-frame" data-clip>
          <Image src={moucharabieh} alt={fr ? 'Salle aux murs rayés et moucharabieh lumineux sous les lustres' : 'Striped walls and a glowing mashrabiya beneath chandeliers'} widths={[480, 800, 1100]} sizes="(max-width: 800px) 90vw, 36vw" />
        </figure>
        <div class="salle__text">
          <Rosette class="salle__rosette" />
          <p data-reveal>{c.salle.p1}</p>
          <p data-reveal>{c.salle.p2}</p>
        </div>
        <figure class="salle__b media" data-parallax="10">
          <Image src={sallePlafond} alt={fr ? 'Le plafond rouge constellé de lanternes' : 'The red ceiling studded with lanterns'} widths={[640, 1100, 1440]} sizes="(max-width: 800px) 90vw, 50vw" />
        </figure>
        <figure class="salle__c arch-frame" data-clip>
          <Image src={longueTable} alt={fr ? 'La longue table dressée sous les lustres de cristal' : 'The long table set beneath crystal chandeliers'} widths={[400, 700]} sizes="(max-width: 800px) 60vw, 22vw" />
        </figure>
      </div>
      <ul class="figs" role="list">
        {c.salle.figs.map(([n, l, year]) => (
          <li data-reveal>
            <span class="figs__n num" data-count={n} data-nogroup={year ? '' : undefined}>{n}</span>
            <span class="eyebrow">{l}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 18 h · Les mezzés (the page's one pinned section) -->
  <section class="mezze" data-chapter={c.mezze.chapter} data-hour={c.mezze.hour} data-hscroll>
    <div class="mezze__track" data-hscroll-track>
      <div class="mezze__intro">
        <header class="chap">
          <span class="chap__ar ar-accent" lang="ar" aria-hidden="true">٢</span>
          <span class="chap__hour">{c.mezze.hour}</span>
          <p class="eyebrow">{c.mezze.chapter}</p>
        </header>
        <h2 data-split>{c.mezze.title[0]}{' '}<em>{c.mezze.title[1]}</em></h2>
        <p class="muted" data-reveal>{c.mezze.text}</p>
        <a href={url('menu-dinner', lang)} class="link" data-reveal>{fr ? 'Les mezzés au menu' : 'Mezze on the menu'} →</a>
      </div>
      {mezzes.map((m, i) => (
        <figure class="plate">
          <div class:list={['plate__img', i % 2 ? 'arch-soft' : 'arch-frame']}>
            <Image src={m.img} alt={tr(m.name)} widths={[420, 700, 960]} sizes="(max-width: 900px) 72vw, 28vw" />
          </div>
          <figcaption>
            <span class="plate__ar ar-accent" lang="ar" aria-hidden="true">{m.ar}</span>
            <span class="plate__n num">{String(i + 1).padStart(2, '0')}</span>
            <strong>{tr(m.name)}</strong>
            <span class="muted">{tr(m.note)}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- 19 h · La braise -->
  <section class="braise section on-image" data-chapter={c.braise.chapter} data-hour={c.braise.hour}>
    <div class="braise__bg media" data-parallax="12">
      <Image src={braise} alt={fr ? 'Poisson entier grillé sur le charbon de bois' : 'Whole fish grilling over charcoal'} widths={[800, 1280, 1800]} sizes="100vw" />
    </div>
    <div class="braise__shade"></div>
    <Embers />
    <div class="wrap braise__grid">
      <div class="braise__head">
        <header class="chap">
          <span class="chap__ar ar-accent" lang="ar" aria-hidden="true">٣</span>
          <span class="chap__hour">{c.braise.hour}</span>
          <p class="eyebrow">{c.braise.chapter}</p>
        </header>
        <h2 data-split>{c.braise.title[0]}{' '}<em>{c.braise.title[1]}</em></h2>
        <p data-reveal>{c.braise.text}</p>
      </div>
      <div class="sig" data-sig>
        <p class="eyebrow">{c.braise.list}</p>
        <ol class="sig__list" role="list">
          {signatures.map((s, i) => (
            <li class="sig__row" data-sig-row={i} data-reveal>
              <span class="sig__num num">{String(i + 1).padStart(2, '0')}</span>
              <span class="sig__name">{s.dish.name[lang]}</span>
              <span class="sig__price num">{s.dish.price}</span>
              {s.dish.desc && <span class="sig__desc">{s.dish.desc[lang]}</span>}
            </li>
          ))}
        </ol>
        <div class="sig__float" aria-hidden="true">
          {signatures.map((s, i) => <Image src={s.img} alt="" widths={[360]} sizes="18rem" class="sig__img" data-sig-img={i} />)}
        </div>
      </div>
    </div>
  </section>

  <!-- 20 h · Le voyage -->
  <section class="voyage section" data-chapter={c.voyage.chapter} data-hour={c.voyage.hour} data-blooms>
    <div class="wrap voyage__grid">
      <figure class="voyage__img arch-frame" data-clip>
        <Image src={freekeh} alt={fr ? 'Moujaddara aux oignons croustillants et herbes' : 'Moujaddara with crisp onions and herbs'} widths={[500, 900, 1200]} sizes="(max-width: 800px) 90vw, 40vw" />
      </figure>
      <div class="voyage__card" data-reveal>
        <header class="chap chap--center">
          <span class="chap__ar ar-accent" lang="ar" aria-hidden="true">٤</span>
          <span class="chap__hour">{c.voyage.hour}</span>
          <p class="eyebrow">{c.voyage.chapter}</p>
        </header>
        <h2>{c.voyage.title[0]}{' '}<em>{c.voyage.title[1]}</em></h2>
        <p class="voyage__price num">{tasting.price} <small>$ · {tr(tasting.per)}</small></p>
        <p class="muted">{tr(tasting.text)}</p>
        <svg class="voyage__tilde" viewBox="0 0 60 12" aria-hidden="true" data-draw><path d="M2 8 C 14 -2, 22 14, 30 6 S 46 -2, 58 6" fill="none" stroke="currentColor" stroke-width="1.2" /></svg>
        <ul class="pairings" role="list">
          {tasting.pairings.map((p) => <li><span>{tr(p.name)}</span><span class="pairings__dots" aria-hidden="true"></span><span class="num">+ {p.price}</span></li>)}
        </ul>
        <div class="voyage__cta">
          <a href={url('reserve', lang)} class="btn btn--accent">{t.reserveTable}</a>
          <a href={url('menu-dinner', lang, 'degustation')} class="link">{fr ? 'Le menu du soir' : 'The dinner menu'} →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 21 h · Le bar et la cave -->
  <section class="bar" data-chapter={c.bar.chapter} data-hour={c.bar.hour}>
    <div class="marquee" aria-hidden="true" data-marquee>
      <div class="marquee__row">{[0, 1].map(() => <span>{cocktails.map((n) => <><em>{n}</em><i>✦</i></>)}</span>)}</div>
    </div>
    <div class="section wrap bar__grid">
      <div class="bar__text">
        <header class="chap">
          <span class="chap__ar ar-accent" lang="ar" aria-hidden="true">٥</span>
          <span class="chap__hour">{c.bar.hour}</span>
          <p class="eyebrow">{c.bar.chapter}</p>
        </header>
        <h2 data-split>{c.bar.title[0]}{' '}<em>{c.bar.title[1]}</em></h2>
        <p class="muted" data-reveal>{c.bar.text}</p>
      </div>
      <figure class="bar__a arch-frame" data-clip>
        <Image src={cocktailRose} alt={fr ? 'Cocktail garni de pétales de rose' : 'Cocktail garnished with rose petals'} widths={[480, 800]} sizes="(max-width: 800px) 70vw, 28vw" />
      </figure>
      <figure class="bar__b media" data-parallax="10">
        <Image src={barman} alt={fr ? 'Le barman verse un cocktail' : 'The bartender pouring a cocktail'} widths={[400, 700]} sizes="(max-width: 800px) 50vw, 20vw" />
      </figure>
      <div class="cellar" data-reveal>
        <figure class="cellar__img arch-soft"><Image src={bargylus} alt={fr ? 'Bouteilles de Bargylus, vin de Syrie' : 'Bottles of Bargylus, a Syrian wine'} widths={[400, 760]} sizes="(max-width: 800px) 70vw, 22vw" /></figure>
        <div class="cellar__text">
          <p class="eyebrow">{c.bar.levant}</p>
          <ul class="cellar__list" role="list">
            {levantWines.map((w) => <li><span class="cellar__name">{w.name}</span><span class="muted">{w.grapes} · {tr(w.origin)}</span></li>)}
          </ul>
          <p class="eyebrow">{c.bar.arak}</p>
          <p class="muted">{araks.join(' · ')}</p>
          <a href={url('menu-wine', lang)} class="btn btn--ghost">{c.bar.wine} <span class="arrow">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- Le week-end · Le brunch -->
  <section class="brunch section" data-chapter={c.brunch.chapter} data-hour={c.brunch.hour}>
    <div class="wrap brunch__grid">
      <figure class="brunch__a arch-frame" data-clip>
        <Image src={brunchOeufs} alt={fr ? 'Faux-filet grillé et œufs ottomans au brunch' : 'Grilled ribeye and Ottoman eggs at brunch'} widths={[480, 800, 1100]} sizes="(max-width: 800px) 80vw, 34vw" />
      </figure>
      <div class="brunch__text">
        <header class="chap">
          <span class="chap__ar ar-accent" lang="ar" aria-hidden="true">٦</span>
          <span class="chap__hour">{c.brunch.hour}</span>
          <p class="eyebrow">{c.brunch.chapter}</p>
        </header>
        <h2 data-split>{c.brunch.title[0]}{' '}<em>{c.brunch.title[1]}</em></h2>
        <p class="muted" data-reveal>{c.brunch.text}</p>
        <a href={url('menu-brunch', lang)} class="btn btn--ghost" data-reveal>{c.brunch.cta} <span class="arrow">→</span></a>
      </div>
      <figure class="brunch__b media" data-parallax="12">
        <Image src={brunchBoeuf} alt="" widths={[400, 700]} sizes="(max-width: 800px) 50vw, 20vw" />
      </figure>
    </div>
  </section>

  <!-- Les salons -->
  <section class="salons oxblood" data-chapter={c.salons.chapter} data-hour={c.salons.hour}>
    <div class="salons__media" data-salons>
      <picture>
        <source media="(max-width: 760px)" srcset={salonsTallSrcset} sizes="100vw" type="image/avif" />
        <Image src={salons} alt={fr ? 'Salon privé dressé pour une longue tablée' : 'Private salon set for a long table'} widths={[800, 1280, 1772]} sizes="100vw" />
      </picture>
    </div>
    <div class="wrap salons__text">
      <header class="chap">
        <span class="chap__ar ar-accent" lang="ar" aria-hidden="true">٧</span>
        <span class="chap__hour">{c.salons.hour}</span>
        <p class="eyebrow">{c.salons.chapter}</p>
      </header>
      <h2 data-split>{c.salons.title[0]}{' '}<em>{c.salons.title[1]}</em></h2>
      <p data-reveal>{c.salons.text}</p>
      <a href={url('events', lang)} class="btn btn--accent" data-reveal>{c.salons.cta} <span class="arrow">→</span></a>
    </div>
  </section>

  <!-- Distinctions + the tale -->
  <section class="honours section">
    <div class="wrap">
      <p class="eyebrow" data-reveal>{c.honours}</p>
      <ul class="honours__row" role="list">
        {site.awards.map((a) => (
          <li data-reveal><span class="honours__name">{a.label[lang]}</span>{a.year && <span class="honours__year num">{a.year}</span>}</li>
        ))}
      </ul>
      <blockquote class="tale" data-reveal>
        <Rosette class="tale__rosette" />
        <p>{c.tale}</p>
      </blockquote>
    </div>
  </section>
</Base>

<style>
  /* Chapter heading: Arabic numeral, the hour, the chapter name */
