---
import { Image } from 'astro:assets';
import { routes, t, type Lang } from '../i18n/ui';
import { site } from '../data/site';
import { glossary } from '../data/glossary';
import Rosette from '../components/Rosette.astro';
import heroImg from '../assets/photos/salle-soir.jpg';
import salleLarge from '../assets/photos/salle-large.jpg';
import salleTables from '../assets/photos/salle-tables.jpg';
import salon from '../assets/photos/salon-lanternes.jpg';
import tablePartage from '../assets/photos/table-partage.jpg';
import four from '../assets/photos/four-pain.jpg';
import barLumieres from '../assets/photos/bar-lumieres.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const fr = lang === 'fr';
const s = t[lang];

const timeline = fr
  ? [
      { y: '2010', t: 'La première nuit', d: 'Damas ouvre ses portes et fait découvrir la cuisine syrienne aux Montréalais.' },
      { y: '2015', t: 'Avenue Van Horne', d: `La maison s’installe dans un espace plus grand, au coin de Bloomfield, à Outremont : une centaine de places et une terrasse de ${site.terraceSeats} places pour la belle saison.` },
      { y: '★', t: "Canada's 100 Best", d: 'Damas figure au palmarès des meilleurs restaurants au pays.' },
      { y: '2025', t: 'Guide MICHELIN', d: 'Lors de la toute première édition du Guide MICHELIN au Québec, Damas reçoit un Bib Gourmand.' },
    ]
  : [
      { y: '2010', t: 'The first night', d: 'Damas opens its doors and introduces Montrealers to Syrian cuisine.' },
      { y: '2015', t: 'Van Horne Avenue', d: `The house moves into a larger space at the corner of Bloomfield, in Outremont: about a hundred seats and a ${site.terraceSeats}-seat terrace for the warmer months.` },
      { y: '★', t: "Canada's 100 Best", d: "Damas is named among the country's best restaurants." },
      { y: '2025', t: 'MICHELIN Guide', d: "In the very first MICHELIN Guide for Québec, Damas is awarded a Bib Gourmand." },
    ];

const rituals = fr
  ? [
      { ar: 'أهلاً وسهلاً', tr: 'Ahlan wa sahlan', t: 'L’accueil', d: 'On entre comme on entre dans une maison de Damas : attendu, reçu, installé.' },
      { ar: 'مازة', tr: 'Mezzé', t: 'Le partage', d: 'Rien ne se mange seul. Les petits plats arrivent au centre et circulent de main en main.' },
      { ar: 'خبز', tr: 'Khubz', t: 'Le pain', d: 'Il sort du four, gonflé et brûlant, et sert de cuillère autant que d’accompagnement.' },
      { ar: 'صحتين', tr: 'Sahtein', t: 'Le souhait', d: 'Littéralement « deux santés » : ainsi se souhaite le bon appétit, en Syrie.' },
    ]
  : [
      { ar: 'أهلاً وسهلاً', tr: 'Ahlan wa sahlan', t: 'The welcome', d: 'You enter as you would a home in Damascus: expected, received, settled in.' },
      { ar: 'مازة', tr: 'Mezze', t: 'The sharing', d: 'Nothing is eaten alone. Small dishes land in the middle and pass from hand to hand.' },
      { ar: 'خبز', tr: 'Khubz', t: 'The bread', d: 'Straight from the oven, puffed and piping hot — as much a spoon as a side.' },
      { ar: 'صحتين', tr: 'Sahtein', t: 'The wish', d: 'Literally “two healths”: this is how Syrians wish you a good meal.' },
    ];
---
<section class="shero">
  <div class="shero__img" data-parallax="10">
    <Image src={heroImg} alt={fr ? 'La salle de Damas un soir de service, sous les lanternes' : 'The Damas dining room on a busy night, under the lanterns'} widths={[800, 1280, 2048]} sizes="100vw" loading="eager" fetchpriority="high" />
  </div>
  <div class="shero__shade"></div>
  <div class="wrap shero__text">
    <p class="eyebrow">{s.nav.story}</p>
    <h1 class="display h-xl" data-reveal="line">{fr ? <>Il était une fois, <em>avenue Van Horne</em></> : <>Once upon a time, <em>on Van Horne Avenue</em></>}</h1>
  </div>
</section>

<section class="sintro wrap">
  <Rosette class="sintro__rosette" />
  <p class="lede" data-reveal="scrub">
    {fr
      ? `Shéhérazade racontait une histoire chaque nuit pour que l’aube n’arrive jamais. Chez Damas, le chef ${site.chef} fait de même avec la Syrie : chaque soir, un nouveau récit de Damas et d’Alep, raconté par le feu, les épices et le partage.`
      : `Scheherazade told a story every night so that dawn would never come. At Damas, chef ${site.chef} does the same with Syria: each evening, a new tale of Damascus and Aleppo, told through fire, spice and sharing.`}
  </p>
</section>

<section class="timeline wrap" aria-labelledby="tl-title">
  <h2 id="tl-title" class="eyebrow">{fr ? 'Les grandes nuits' : 'The great nights'}</h2>
  <ol>
    {timeline.map((it) => (
      <li data-reveal="fade">
        <span class="timeline__y display">{it.y}</span>
        <div>
          <h3 class="display h-m">{it.t}</h3>
          <p class="muted">{it.d}</p>
        </div>
      </li>
    ))}
  </ol>
</section>

<section class="decor">
  <div class="wrap decor__grid">
    <div class="decor__text">
      <p class="eyebrow">{fr ? 'Le décor' : 'The setting'}</p>
      <h2 class="display h-l" data-reveal="line">{fr ? <>Un palais <em>des Mille et Une Nuits</em></> : <>A palace <em>of a Thousand and One Nights</em></>}</h2>
      <p class="muted" data-reveal="fade">
        {fr
          ? 'Plafonds rouges constellés de lanternes, murs rayés à la manière des palais damascènes, moucharabiehs, velours, bois sculpté, lustres de perles et de cristal, banquettes aux motifs turquoise : chaque salle est un chapitre, chaque coin une alcôve où la soirée se prolonge.'
          : 'Red ceilings studded with lanterns, walls striped like the palaces of Damascus, mashrabiya screens, velvet, carved wood, beaded crystal chandeliers, turquoise-patterned banquettes: every room is a chapter, every corner an alcove where the evening lingers.'}
      </p>
    </div>
    <figure class="decor__a arch" data-reveal="arch">
      <Image src={salon} alt={fr ? 'Alcôve aux banquettes turquoise sous des lustres de perles' : 'Alcove with turquoise banquettes beneath beaded chandeliers'} widths={[480, 900]} sizes="(max-width: 800px) 80vw, 34vw" loading="lazy" />
    </figure>
    <figure class="decor__b" data-reveal="fade">
      <div data-parallax="12"><Image src={salleLarge} alt={fr ? 'Vue d’ensemble de la salle rouge et de ses lanternes' : 'The red dining room and its lanterns'} widths={[640, 1080]} sizes="(max-width: 800px) 90vw, 50vw" loading="lazy" /></div>
    </figure>
    <figure class="decor__c arch-soft" data-reveal="arch">
      <Image src={salleTables} alt="" widths={[400, 700]} sizes="(max-width: 800px) 60vw, 24vw" loading="lazy" />
    </figure>
  </div>
</section>

<section class="rituals wrap" aria-labelledby="rituals-title">
  <p class="eyebrow">{fr ? 'L’art de recevoir' : 'The art of hospitality'}</p>
  <h2 id="rituals-title" class="display h-l" data-reveal="line">{fr ? <>Recevoir <em>à la syrienne</em></> : <>Hospitality, <em>the Syrian way</em></>}</h2>
  <ul class="rituals__grid">
    {rituals.map((r, i) => (
      <li class="ritual" data-reveal="fade" data-delay={String(i * 0.08)}>
        <span class="ritual__ar arabic" lang="ar">{r.ar}</span>
        <span class="ritual__tr">{r.tr}</span>
        <h3 class="display">{r.t}</h3>
        <p class="muted">{r.d}</p>
      </li>
    ))}
  </ul>
  <div class="rituals__imgs">
    <figure class="arch" data-reveal="arch"><Image src={tablePartage} alt={fr ? 'Une table garnie de mezzés et de grillades à partager' : 'A table laden with mezzes and grills to share'} widths={[480, 900]} sizes="(max-width: 800px) 90vw, 40vw" loading="lazy" /></figure>
    <figure class="arch-soft" data-reveal="arch"><Image src={four} alt={fr ? 'Le pain sort du four' : 'Bread coming out of the oven'} widths={[400, 700]} sizes="(max-width: 800px) 60vw, 26vw" loading="lazy" /></figure>
  </div>
</section>

<section class="lexicon" aria-labelledby="lex-title">
  <div class="wrap">
    <div class="lexicon__head">
      <p class="eyebrow">{fr ? 'Petit lexique' : 'A small lexicon'}</p>
      <h2 id="lex-title" class="display h-l" data-reveal="line">{fr ? <>Les mots <em>de la table</em></> : <>Words <em>of the table</em></>}</h2>
      <p class="muted" data-reveal="fade">{fr ? 'Pour lire le menu comme on lit un conte.' : 'To read the menu the way you would read a tale.'}</p>
    </div>
    <dl class="lexicon__list" data-lexicon>
      {glossary.map((g) => (
        <div class="lex" data-reveal="fade">
          <dt>
            <span class="display">{fr ? g.term : g.termEn ?? g.term}</span>
            <span class="lex__ar arabic" lang="ar">{g.ar}</span>
          </dt>
          <dd class="muted">{g.def[lang]}</dd>
        </div>
      ))}
    </dl>
    <div class="lexicon__cta">
      <a class="btn btn--solid" href={routes.menus[lang]}>{s.viewMenus}</a>
    </div>
  </div>
  <figure class="lexicon__bg" aria-hidden="true">
    <Image src={barLumieres} alt="" widths={[800, 1440]} sizes="100vw" loading="lazy" />
  </figure>
</section>

<style>
  .shero { position: relative; height: 100vh; height: 100svh; min-height: 560px; overflow: hidden; display: flex; align-items: flex-end; }
  .shero__img { position: absolute; inset: -8% 0; }
  .shero__img :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .shero__shade { position: absolute; inset: 0; background: linear-gradient(to top, var(--night) 4%, rgb(18 10 13 / 0.2) 55%, rgb(18 10 13 / 0.5)); }
  .shero__text { position: relative; padding-bottom: clamp(3rem, 8vw, 6rem); display: grid; gap: 1.25rem; }
  .shero__text h1 { max-width: 14ch; }
  .shero__text em { color: var(--brass-2); }

  .sintro { padding-block: clamp(5rem, 12vw, 10rem); display: grid; gap: 2rem; justify-items: center; text-align: center; }
  :global(.sintro__rosette) { width: 70px; color: var(--damask); }
  .sintro .lede { max-width: 34ch; font-size: clamp(1.6rem, 3.2vw, 3rem); line-height: 1.2; }

  .timeline { padding-bottom: clamp(5rem, 10vw, 9rem); }
  .timeline ol { list-style: none; padding: 0; margin-top: 2rem; }
  .timeline li { display: grid; grid-template-columns: minmax(8rem, 1fr) 2fr; gap: 2rem; padding: clamp(1.5rem, 3vw, 2.5rem) 0; border-top: 1px solid var(--cream-faint); align-items: baseline; }
  .timeline li:last-child { border-bottom: 1px solid var(--cream-faint); }
  .timeline__y { font-size: clamp(3rem, 8vw, 7rem); color: var(--brass-2); line-height: 0.9; font-style: italic; }
  .timeline h3 { margin-bottom: 0.6rem; }
  .timeline p { max-width: 52ch; }
  @media (max-width: 700px) { .timeline li { grid-template-columns: 1fr; gap: 0.5rem; } }

  .decor { padding-block: clamp(4rem, 10vw, 9rem); background: var(--night-2); }
  .decor__grid { display: grid; grid-template-columns: repeat(12, 1fr); gap: 2rem; align-items: start; }
  .decor__text { grid-column: 1 / span 6; display: grid; gap: 1.5rem; }
  .decor__a { grid-column: 8 / span 5; grid-row: 1 / span 2; aspect-ratio: 3 / 4; margin: 0; }
  .decor__b { grid-column: 1 / span 6; aspect-ratio: 16 / 11; overflow: hidden; margin: 2rem 0 0; }
  .decor__b > div { height: 120%; margin-top: -10%; }
  .decor__c { grid-column: 8 / span 3; aspect-ratio: 3 / 4; margin: 0; }
  .decor :global(img) { width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 800px) {
    .decor__text, .decor__b { grid-column: 1 / -1; }
    .decor__a { grid-column: 2 / -1; grid-row: auto; }
    .decor__c { grid-column: 1 / span 7; margin-top: -5rem; }
  }

  .rituals { padding-block: clamp(5rem, 12vw, 10rem); display: grid; gap: 1.25rem; }
  .rituals__grid { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; margin-top: 3rem; }
  .ritual { display: grid; gap: 0.6rem; align-content: start; padding-top: 1.5rem; border-top: 1px solid var(--cream-faint); }
  .ritual__ar { font-size: clamp(2rem, 3vw, 2.8rem); color: var(--damask); line-height: 1.3; justify-self: start; }
  .ritual__tr { font-size: 0.72rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--brass); }
  .ritual h3 { font-size: 1.6rem; font-weight: 400; }
  .rituals__imgs { display: grid; grid-template-columns: 1.5fr 1fr; gap: 2rem; margin-top: 4rem; align-items: end; }
  .rituals__imgs figure { margin: 0; aspect-ratio: 4 / 5; }
  .rituals__imgs figure:first-child { aspect-ratio: 5 / 4; }
  .rituals__imgs :global(img) { width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 900px) { .rituals__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .rituals__grid, .rituals__imgs { grid-template-columns: 1fr; } }

  .lexicon { position: relative; padding-block: clamp(5rem, 12vw, 10rem); overflow: hidden; isolation: isolate; }
  .lexicon__bg { position: absolute; inset: 0; z-index: -1; margin: 0; opacity: 0.16; }
  .lexicon__bg :global(img) { width: 100%; height: 100%; object-fit: cover; filter: blur(2px); }
  .lexicon__bg::after { content: ''; position: absolute; inset: 0; background: linear-gradient(var(--night), transparent 20%, transparent 80%, var(--night)); }
  .lexicon__head { display: grid; gap: 1.25rem; max-width: 40rem; margin-bottom: 3rem; }
  .lexicon__list { display: grid; grid-template-columns: 1fr 1fr; gap: 0 4rem; }
  .lex { padding: 1.4rem 0; border-top: 1px solid var(--cream-faint); display: grid; gap: 0.4rem; transition: background 0.5s; }
  .lex dt { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
  .lex dt .display { font-size: clamp(1.4rem, 2.2vw, 2rem); transition: color 0.4s, transform 0.6s var(--ease); }
  .lex__ar { font-size: 1.6rem; color: var(--damask); transition: transform 0.6s var(--ease), color 0.4s; }
  .lex:hover dt .display { color: var(--brass-2); transform: translateX(0.3rem); }
  .lex:hover .lex__ar { transform: scale(1.25); color: var(--brass-2); }
  .lex dd { margin: 0; font-size: 0.95rem; max-width: 48ch; }
  .lexicon__cta { margin-top: 3.5rem; }
  @media (max-width: 800px) { .lexicon__list { grid-template-columns: 1fr; } }
</style>
